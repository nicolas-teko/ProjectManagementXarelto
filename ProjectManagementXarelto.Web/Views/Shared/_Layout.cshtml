@using Microsoft.AspNetCore.Http
@{
    var currentUserName = Context.Session.GetString("CurrentUserName");
    var currentUserRole = Context.Session.GetString("CurrentUserRole");
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Xarelto Projekte</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="app-shell header-content">
            <a class="brand" asp-controller="Projects" asp-action="Index" aria-label="Zur Projektübersicht">
                <span class="brand-mark">X</span>
                <span>Xarelto <strong>Projekte</strong></span>
            </a>
            @if (!string.IsNullOrEmpty(currentUserName))
            {
                <nav class="main-nav" aria-label="Hauptnavigation"><a asp-controller="Projects" asp-action="Index">Projekte</a></nav>
                <div class="user-menu">
                    <div class="user-avatar">@currentUserName[..1].ToUpperInvariant()</div>
                    <div class="user-label"><strong>@currentUserName</strong><span>@currentUserRole</span></div>
                    <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="button button-quiet">Abmelden</button></form>
                </div>
            }
        </div>
    </header>
    <main class="app-shell page-content" role="main">
        @if (TempData["Success"] is string success)
        {
            <div class="notice notice-success" role="status">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="notice notice-error" role="alert">@error</div>
        }
        @RenderBody()
    </main>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
